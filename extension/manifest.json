{
  "manifest_version": 3,
  "name": "Chatx",
  "version": "0.1.16",
  "description": "让 ChatGPT Chat 使用你本机的文件、终端和 GPU。",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Chatx"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "protocol.js",
        "chat-dom.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
